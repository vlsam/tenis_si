# Copy to `.env.local` and fill in real values. Never commit the filled-in
# file (.env.local is in .gitignore).

# --- Supabase ---------------------------------------------------------------
# From your Supabase project's Settings > API. The anon key is PUBLIC (it's
# sent to the browser) - that's expected, it only works within RLS. The
# service role key is SECRET - it bypasses RLS entirely, must never be
# NEXT_PUBLIC_-prefixed, and is only read by src/lib/supabase/admin.ts
# (server-only code: the SMS webhook, the e-mail confirm/reject link, and
# the cron expire-orders job).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shows a loud "TESTOVACIA VERZIA" banner on every page and prefixes the
# <title> with "[TEST]" (src/components/DemoBanner.tsx). Defaults to shown -
# set to the literal string "false" once this runs against a real club with
# real bookings/payments, not seeded demo data (see supabase/seed.sql).
NEXT_PUBLIC_DEMO_MODE=true

# Long random string that forms part of the (unauthenticated) SMS gateway
# webhook URL - treat it like a password. Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_SMS_WEBHOOK_SECRET=

# Checked against the `Authorization: Bearer <...>` header on
# /api/cron/expire-orders. If deploying to Vercel with vercel.json's cron
# entry, set a Vercel project env var named exactly CRON_SECRET and Vercel
# will send it automatically - no extra wiring needed.
CRON_SECRET=

# IBAN credited by Pay by Square top-up QR codes. Not a secret (it's on
# every invoice anyway), but must be correct.
BANK_IBAN=SK0000000000000000000000

# --- EuroSMS (SMS gateway - asks the club to reply "A-XXX"/"N-XXX" to a new
# booking; only sent if club_settings.sms_notification is enabled) --------
EUROSMS_INTEGRATION_ID=
EUROSMS_INTEGRATION_KEY=
EUROSMS_NUMBER=

# --- SMTP --------------------------------------------------------------
# Account e-mails (signup confirmation, password reset) are sent by
# Supabase Auth itself - configure those under Auth > Email Templates /
# Auth > SMTP Settings in the Supabase dashboard, not here. These
# credentials are only used by src/lib/email.ts for the two app-specific
# notifications Supabase Auth doesn't know about: notifying the club of a
# new order, and notifying it once one is paid.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Where order/payment notifications above get sent.
CLUB_NOTIFICATION_EMAIL=
